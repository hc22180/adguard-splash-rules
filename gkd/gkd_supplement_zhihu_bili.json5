{
  id: 99887,
  name: "补充开屏-知乎天猫双11+B站激励",
  version: 1,
  author: "custom",
  globalGroups: [
    {
      key: 0,
      name: "开屏广告-通用自动关",
      desc: "照抄Lin-arm已验证写法: 高频轮询, 通吃80%App",
      order: -10,
      fastQuery: true,
      matchTime: 8000,
      forcedTime: 8000,
      actionMaximum: 5,
      resetMatch: "app",
      rules: [
        {
          key: 0,
          excludeMatches: "([text=\"Submit\" || text=\"书签\" || text=\"NEXT\" || text=\"覆盖\" || text*=\"阅读并同意\" || text=\"跳过空白\"][visibleToUser=true]) || ([text*=\"搜索\" || text=\"历史记录\" || text$=\"在搜\"][text.length>3 && text.length<7][visibleToUser=true]) || ([text$=\"设置\" || text*=\"跳过片\"][text.length<10][visibleToUser=true])",
          anyMatches: [
            "[text*=\"跳过\"][text.length<10][width<500 && height<300][visibleToUser=true]",
            "[text*=\"skip\"][text.length<10][visibleToUser=true]",
            "[vid*=\"skip\"][visibleToUser=true]",
            "[desc*=\"跳过\"][desc.length<10][visibleToUser=true]",
            "@[name$=\"View\" || name$=\"LinearLayout\"][clickable=true][childCount<2][width<300 && height<200] - [text=\"互动广告\"][visibleToUser=true]",
            "[vid=\"iv_close\"][visibleToUser=true]",
            "[desc*=\"关闭\"][desc.length<10][visibleToUser=true]",
            "[text*=\"关闭\"][text.length<10][visibleToUser=true]"
          ]
        },
        {
          key: 1,
          "desc": "阿里双11/淘宝/京东开屏小×关闭钮兜底(收紧: 只在带'广告'特征的开屏才点, 不误伤搜索框)",
          anyMatches: [
            "ImageView[clickable=true][childCount=0][width<120 && height<120][visibleToUser=true] - *[text*=\"广告\"][visibleToUser=true]",
            "@View[text=null][clickable=true][childCount=0][visibleToUser=true][width<200 && height<200] +(1,2) TextView[index=parent.childCount.minus(1)][childCount=0] <n FrameLayout[childCount>2][text=null][desc=null] >(n+6) [text*=\"第三方应用\" || text*=\"扭动手机\" || text*=\"点击或上滑\" || text*=\"省钱好物\" || text*=\"扭一扭\"][visibleToUser=true]"
          ]
        },
        {
          key: 2,
          "desc": "开屏页带'广告'字样时的小关闭钮兜底(限定: 页面里必须出现'广告'二字才生效)",
          anyMatches: [
            "[desc*=\"关闭\"][clickable=true][desc.length<10][visibleToUser=true] - *[text*=\"广告\"][visibleToUser=true]"
          ]
        }
      ]
    }
  ],
  apps: [
    {
      id: "com.zhihu.android",
      name: "知乎",
      groups: [
        {
          key: -1,
          name: "开屏广告-全素材",
          desc: "照抄Lin-arm已验证: 跳过钮+天猫淘宝双11小关闭钮+扭动手机兜底",
          fastQuery: true,
          matchTime: 8000,
          actionMaximum: 3,
          resetMatch: "app",
          order: -10,
          rules: [
            {
              key: 0,
              excludeActivityIds: [".app.SearchActivity", ".comment.ui.activity.CommentListActivity"],
              matches: "([vid=\"btn_skip\"][visibleToUser=true]) || ([text*=\"跳过\"][text.length<10][width<500 && height<300][visibleToUser=true])"
            },
            {
              key: 1,
              matches: "TextView[width<114 && height<67] - @View[clickable=true][visibleToUser=true][width<135] <3 FrameLayout[childCount=4][getChild(1).getChild(0).childCount=3] <2 FrameLayout[childCount=2][getChild(0).width=0] < [vid=\"show_layout\"]"
            },
            {
              key: 2,
              matches: "@View[text=null][clickable=true][childCount=0][visibleToUser=true][width<200 && height<200] +(1,2) TextView[index=parent.childCount.minus(1)][childCount=0] <n FrameLayout[childCount>2][text=null][desc=null] >(n+6) [text*=\"第三方应用\" || text*=\"扭动手机\" || text*=\"点击或上滑\" || text*=\"省钱好物\" || text*=\"扭一扭\"][visibleToUser=true]"
            }
          ]
        }
      ]
    },
    {
      id: "tv.danmaku.bili",
      name: "哔哩哔哩",
      groups: [
        {
          key: 31,
          name: "局部广告-应用小助手激励视频",
          desc: "点右上角[广告]关闭",
          fastQuery: true,
          actionMaximum: 1,
          resetMatch: "app",
          rules: [
            { key: 1, matches: "[vid=\"count_down\" || vid=\"skip\"][visibleToUser=true]" },
            { key: 2, preKeys: [1], matches: "ImageView[vid=\"close\"][desc=\"关闭\"][clickable=true]" }
          ]
        }
      ]
    }
  ]
}
