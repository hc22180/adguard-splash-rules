{
  id: 8866,
  name: "开屏补充(保守版)-只认跳过/关闭文字+广告特征",
  version: 2,
  author: "custom",
  globalGroups: [
    {
      key: 0,
      name: "开屏广告-保守自动关",
      desc: "防误点优先: 只认文字跳过/关闭, 不碰小图标, 额度压到2次4秒收手",
      order: -10,
      fastQuery: true,
      matchTime: 4000,
      forcedTime: 4000,
      actionMaximum: 2,
      resetMatch: "app",
      rules: [
        {
          key: 0,
          "desc": "只点文字'跳过/关闭'的, 不限定尺寸, 避免误伤搜索框小图标",
          anyMatches: [
            "[text*=\"跳过\"][text.length<10][visibleToUser=true]",
            "[text*=\"skip\"][text.length<10][visibleToUser=true]",
            "[text*=\"关闭\"][text.length<10][visibleToUser=true]",
            "[desc*=\"跳过\"][desc.length<10][visibleToUser=true]",
            "[desc*=\"关闭\"][desc.length<10][visibleToUser=true]"
          ]
        },
        {
          key: 1,
          "desc": "带'广告'字样的小关闭钮兜底(页面必须出现'广告'二字才点, 搜索框旁没有, 安全)",
          anyMatches: [
            "ImageView[clickable=true][childCount=0][width<120 && height<120][visibleToUser=true] - *[text*=\"广告\"][visibleToUser=true]"
          ]
        }
      ]
    }
  ],
  apps: [
    {
      id: "com.zhihu.android",
      name: "知乎",
      groups: [
        {
          key: -1,
          name: "开屏广告-全素材",
          desc: "照抄Lin-arm已验证: 跳过钮+天猫淘宝双11小关闭钮+扭动手机兜底",
          fastQuery: true,
          matchTime: 4000,
          actionMaximum: 2,
          resetMatch: "app",
          order: -10,
          rules: [
            {
              key: 0,
              excludeActivityIds: [".app.SearchActivity", ".comment.ui.activity.CommentListActivity"],
              matches: "([vid=\"btn_skip\"][visibleToUser=true]) || ([text*=\"跳过\"][text.length<10][width<500 && height<300][visibleToUser=true])"
            },
            {
              key: 1,
              matches: "TextView[width<114 && height<67] - @View[clickable=true][visibleToUser=true][width<135] <3 FrameLayout[childCount=4][getChild(1).getChild(0).childCount=3] <2 FrameLayout[childCount=2][getChild(0).width=0] < [vid=\"show_layout\"]"
            },
            {
              key: 2,
              matches: "@View[text=null][clickable=true][childCount=0][visibleToUser=true][width<200 && height<200] +(1,2) TextView[index=parent.childCount.minus(1)][childCount=0] <n FrameLayout[childCount>2][text=null][desc=null] >(n+6) [text*=\"第三方应用\" || text*=\"扭动手机\" || text*=\"点击或上滑\" || text*=\"省钱好物\" || text*=\"扭一扭\"][visibleToUser=true]"
            }
          ]
        }
      ]
    },
    {
      id: "tv.danmaku.bili",
      name: "哔哩哔哩",
      groups: [
        {
          key: 31,
          name: "局部广告-应用小助手激励视频",
          desc: "点右上角[广告]关闭",
          fastQuery: true,
          actionMaximum: 1,
          resetMatch: "app",
          rules: [
            { key: 1, matches: "[vid=\"count_down\" || vid=\"skip\"][visibleToUser=true]" },
            { key: 2, preKeys: [1], matches: "ImageView[vid=\"close\"][desc=\"关闭\"][clickable=true]" }
          ]
        }
      ]
    }
  ]
}
